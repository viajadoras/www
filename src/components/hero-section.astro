---
import { Image } from 'astro:assets';
import heroMainImg from '../assets/images/hero-main.png';
import AppStoreBadges from './AppStoreBadges.astro';

const proofs = ['Só mulheres', 'Selfie verificada pela equipe', 'Gratuito'];
---

<section class="relative overflow-hidden bg-neutral-50 py-12 lg:py-16">
  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-12">
    <div class="grid items-center gap-8 lg:grid-cols-[0.98fr_1.02fr] lg:gap-12">
      <div class="max-w-xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-primary/10 bg-white px-4 py-2 text-sm font-semibold text-neutral-700">
          <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span>
          Viagens e rolês só de mulheres
        </p>

        <h1 class="mt-6 font-display text-[2.4rem] font-semibold leading-none tracking-tight text-neutral-900 sm:text-[3rem] lg:text-[3.45rem]">
          Viaje sozinha
          <span class="text-primary-700"> sem ficar sozinha.</span>
        </h1>

        <p class="mt-5 max-w-lg text-lg leading-relaxed text-neutral-700 sm:text-[1.15rem]">
          Dica de quem já foi, companhia no destino e rolês na sua cidade com
          outras mulheres de espírito viajante.
        </p>

        <ul class="mt-5 flex flex-wrap gap-3 text-sm font-semibold text-neutral-800">
          {proofs.map((proof) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-4 py-2">
              <svg class="h-4 w-4 text-teal-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
              </svg>
              {proof}
            </li>
          ))}
        </ul>

        <div class="mt-7">
          <AppStoreBadges
            class="flex flex-row flex-wrap items-center gap-3"
            imgClass="h-auto w-36 sm:w-44"
          />
        </div>
      </div>

      <div class="relative">
        <div class="overflow-hidden rounded-[2.25rem] border border-white/60 bg-white shadow-soft">
          <Image
            src={heroMainImg}
            alt="Grupo de amigas sorrindo juntas em um mirante com vista para a cidade e o mar"
            class="h-[340px] w-full object-cover object-[98%_top] sm:h-[390px] lg:h-[460px]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>
</section>

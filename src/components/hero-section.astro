---
import { Image } from 'astro:assets';
import planos from '../assets/images/planos-demo.webp';
import foto from '../assets/images/gallery/gallery-5.png';
import AppStoreBadges from './AppStoreBadges.astro';
---
<section id="para-quem" class="bg-secondary-50">
  <div class="container grid items-center gap-6 py-8 sm:py-12 lg:grid-cols-2 lg:gap-14">
    <div class="max-w-xl">
      <p class="font-semibold text-primary-700">Viagens e rolês só de mulheres</p>
      <h1 id="abertura" class="mt-3 text-balance font-display text-[clamp(2.35rem,4.5vw,4rem)] font-semibold leading-[1.06] text-primary-900">Encontre uma parceira de viagem.</h1>
      <p class="mt-4 text-lg leading-relaxed">Conte para onde vai e combine um passeio com outras viajadoras no destino. Ainda sem viagem marcada? Combine um café, uma trilha ou um show na sua cidade.</p>
      <p class="mt-4 text-sm leading-relaxed text-neutral-700">App gratuito para mulheres maiores de 18 anos. A equipe analisa sua selfie antes de liberar a comunidade. <a href="/ajuda/#entrada" data-action="verificacao" class="font-semibold text-primary-800 underline underline-offset-4">Entenda a entrada</a>.</p>
      <div class="mt-5" data-cta="home_abertura"><AppStoreBadges class="flex flex-wrap items-center gap-3" imgClass="h-auto w-32 sm:w-36" /></div>
    </div>
    <figure class="relative isolate mx-auto w-full max-w-xl overflow-hidden rounded-3xl bg-secondary-200">
      <Image src={foto} alt="" widths={[480,800,1120]} sizes="(min-width: 1024px) 540px, 100vw" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" />
      <div class="ml-auto mr-4 mt-4 w-[47%] max-w-60 overflow-hidden rounded-t-2xl border-x-4 border-t-4 border-neutral-900 bg-secondary-50 sm:mr-7 sm:mt-8">
        <Image src={planos} alt="Tela de planos de viagem do app com destinos como Pirenópolis, Chapada dos Veadeiros e Rio de Janeiro." widths={[240,480,660]} sizes="(min-width: 768px) 240px, 45vw" loading="eager" class="w-full" />
      </div>
      <figcaption class="bg-secondary-100 px-4 py-2 text-xs text-neutral-700">Planos de viagem no app · dados de demonstração</figcaption>
    </figure>
  </div>
</section>

<script>
  // Variação exclusiva da prévia para sessões moderadas de compreensão.
  if (['localhost', '127.0.0.1', '[::1]'].includes(location.hostname) &&
      new URLSearchParams(location.search).get('abertura') === 'passeio') {
    const titulo = document.getElementById('abertura');
    if (titulo) titulo.textContent = 'Encontre uma parceira para o próximo passeio.';
  }
</script>

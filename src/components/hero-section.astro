---
import { Image } from 'astro:assets';
import feira from '../assets/images/abertura/feira.webp';
import chapada from '../assets/images/abertura/chapada.webp';
import olinda from '../assets/images/abertura/olinda.webp';
import planos from '../assets/images/planos-demo.webp';
import AppStoreBadges from './AppStoreBadges.astro';
---
<section id="para-quem" class="bg-secondary-50">
  <div class="container grid items-center gap-6 py-8 sm:py-12 lg:grid-cols-2 lg:gap-14">
    <div class="max-w-xl">
      <h1 id="abertura" class="text-balance font-display text-[clamp(2.35rem,4.5vw,4rem)] font-semibold leading-[1.06] text-primary-900">Um app de viagens e rolês só para mulheres</h1>
      <p class="mt-4 text-lg leading-relaxed">Vai viajar? Compartilhe seu roteiro. Está pela cidade? Convide outras viajadoras para um café, uma trilha ou um show.</p>
      <p class="mt-4 text-sm leading-relaxed text-neutral-700">Gratuito para mulheres a partir de 18 anos. A equipe verifica sua selfie antes de liberar o acesso à comunidade. <a href="/ajuda/#entrada" data-action="verificacao" class="font-semibold text-primary-800 underline underline-offset-4">Entenda a entrada</a>.</p>
      <div class="mt-5" data-cta="home_abertura"><AppStoreBadges class="flex flex-wrap items-center gap-3" imgClass="h-auto w-32 sm:w-36" /></div>
    </div>
    <div class="mx-auto grid w-full max-w-xl grid-cols-[3fr_2fr] items-stretch gap-2 sm:gap-3">
      <div class="grid min-w-0 grid-cols-2 gap-2 sm:gap-3">
        <Image src={feira} alt="Três amigas conversam em uma feira de frutas." widths={[320, 480, 720]} sizes="(min-width: 640px) 340px, 56vw" loading="eager" fetchpriority="high" class="col-span-2 block h-auto w-full rounded-2xl" />
        <Image src={chapada} alt="Duas viajadoras de mochila na Chapada dos Veadeiros." widths={[160, 320, 480]} sizes="(min-width: 640px) 168px, 27vw" loading="eager" class="h-full w-full rounded-xl object-cover" />
        <Image src={olinda} alt="Uma viajadora passeia entre as casas coloridas de Olinda." widths={[160, 320, 480]} sizes="(min-width: 640px) 168px, 27vw" loading="eager" class="h-full w-full rounded-xl object-cover" />
      </div>
      <figure class="flex min-w-0 flex-col items-center justify-center gap-2 rounded-2xl bg-secondary-200 p-2 sm:p-3">
        <Image src={planos} alt="Tela do Viajadoras com busca por destino e lista de planos de viagem." widths={[220, 440, 660]} sizes="(min-width: 640px) 200px, 34vw" loading="eager" class="h-auto w-full rounded-xl border border-neutral-300" />
        <figcaption class="text-center text-xs text-neutral-700">Planos de viagem · demonstração</figcaption>
      </figure>
    </div>
  </div>
</section>

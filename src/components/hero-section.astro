---
import { Image } from 'astro:assets';
import feira from '../assets/images/abertura/feira.webp';
import chapada from '../assets/images/abertura/chapada.webp';
import olinda from '../assets/images/abertura/olinda.webp';
import encontro from '../assets/images/abertura/app-evento.webp';
import comunidades from '../assets/images/abertura/app-comunidades.webp';
import planos from '../assets/images/abertura/app-planos.webp';
import AppStoreBadges from './AppStoreBadges.astro';

import jovens from '../assets/images/abertura/jovens.webp';
import cafe from '../assets/images/abertura/cafe.webp';
import barco from '../assets/images/abertura/rio-negro.webp';

const pecas = [
  { id: 'barco', src: barco, alt: 'Cinco mulheres de diferentes gerações passeiam de barco no Rio Negro.' },
  { id: 'planos', src: planos, nome: 'Planos de viagem' },
  { id: 'cafe', src: cafe, alt: 'Uma viajadora de cabelos brancos toma café em São Luís.' },
  { id: 'chapada', src: chapada, alt: 'Duas amigas observam a paisagem da Chapada dos Veadeiros.' },
  { id: 'comunidades', src: comunidades, nome: 'Comunidades' },
  { id: 'feira', src: feira, alt: 'Três amigas conversam em uma feira de Goiânia.' },
  { id: 'jovens', src: jovens, alt: 'Quatro jovens adultas visitam uma banca de livros e discos em São Paulo.' },
  { id: 'olinda', src: olinda, alt: 'Uma viajadora passeia pelas ruas de Olinda.' },
  { id: 'encontro', src: encontro, nome: 'Encontros' },
];
---
<section id="para-quem" class="bg-secondary-50">
  <div class="container grid items-center gap-6 py-8 sm:py-12 lg:grid-cols-[0.8fr_1.35fr] lg:gap-9">
    <div class="max-w-xl">
      <h1 id="abertura" class="text-balance font-display text-[clamp(2.35rem,4.5vw,4rem)] font-semibold leading-[1.06] text-primary-900">Um app gratuito de viagens e rolês só para mulheres</h1>
      <p class="mt-4 text-lg leading-relaxed">Vai viajar? Compartilhe seu roteiro. Está pela cidade? Convide outras viajadoras para um café, uma trilha ou um show.</p>
      <p class="mt-4 text-sm leading-relaxed text-neutral-700">A partir dos 18 anos. A equipe verifica sua selfie antes de liberar o acesso à comunidade. <a href="/ajuda/#entrada" data-action="verificacao" class="font-semibold text-primary-800 underline underline-offset-4">Entenda a entrada</a>.</p>
      <div class="mt-5" data-cta="home_abertura"><AppStoreBadges class="flex flex-wrap items-center gap-3" imgClass="h-auto w-32 sm:w-36" /></div>
    </div>
    <figure class="album">
      <div class="mosaico">
        {pecas.map(({ id, src, alt, nome }, i) => nome ? (
          <a class="amostra" style={`grid-area:${id}`} href={src.src} aria-label={`Ampliar tela de demonstração: ${nome}`}>
            <span class="legenda">{nome}<span aria-hidden="true">↗</span></span>
            <div class="recorte"><Image src={src} alt="" widths={[260, 440]} sizes="220px" loading="eager" /></div>
          </a>
        ) : (
          <Image src={src} alt={alt ?? ''} widths={[280, 480, 720]} sizes="(min-width: 640px) 320px, 78vw"
            class="foto" style={`grid-area:${id}`} loading="eager" fetchpriority={i === 0 ? 'high' : 'auto'} />
        ))}
      </div>
      <figcaption class="mt-2 text-right text-xs text-neutral-600">Telas do app com dados de demonstração</figcaption>
    </figure>
  </div>
</section>

<style>
  .album { width: 100%; min-width: 0; container-type: inline-size; }
  .mosaico {
    display: grid; gap: clamp(4px, .9cqw, 9px); grid-template-columns: repeat(12,minmax(0,1fr));
    grid-auto-rows: 23cqw; border-radius: 1.4rem; overflow: hidden;
    grid-template-areas:
      "barco barco barco barco barco planos planos planos cafe cafe cafe cafe"
      "chapada chapada chapada comunidades comunidades comunidades comunidades feira feira feira feira feira"
      "jovens jovens jovens jovens jovens olinda olinda olinda encontro encontro encontro encontro";
  }
  .foto { width: 100%; height: 100%; object-fit: cover; object-position: center 36%; border-radius: .45rem; }
  .amostra { display: flex; flex-direction: column; overflow: hidden; padding: 5% 6% 0; border-radius: .45rem; background: var(--color-primary-100); color: var(--color-primary-900); }
  .amostra:nth-child(5) { background: var(--color-teal-100); color: var(--color-teal-900); }
  .amostra:last-child { background: var(--color-lavender-100); color: var(--color-lavender-900); }
  .legenda { display: flex; align-items: center; justify-content: space-between; gap: .15rem; padding-bottom: .25rem; font-size: clamp(.74rem,2.1cqw,1rem); font-weight: 700; }
  .recorte { border-radius: .5rem .5rem 0 0; overflow: hidden; }
  .recorte img { width: 100%; height: auto; margin-top: -13%; }
  .amostra:hover .legenda { text-decoration: underline; }
  .amostra:focus-visible { outline: 3px solid var(--color-primary-700); outline-offset: -3px; }
  @container (max-width: 32rem) {
    .mosaico { grid-template-columns: repeat(6, minmax(0,1fr)); grid-auto-rows: 30cqw; grid-template-areas:
      "barco barco barco barco planos planos"
      "cafe cafe cafe feira feira feira"
      "comunidades comunidades chapada chapada olinda olinda"
      "jovens jovens jovens jovens encontro encontro"; }
    .legenda { font-size: clamp(.64rem,3cqw,.84rem); }
  }
</style>

---
import {
  appStoreUrl,
  company,
  contactEmail,
  instagramUrl,
  playStoreUrl,
  siteName,
  siteOrigin,
} from '../data/site';

interface Props {
  type?: 'homepage' | 'about' | 'page';
  title?: string;
  description?: string;
  url?: string;
}

const { type = 'page', title, description, url } = Astro.props;
const origin = (Astro.site?.toString() || siteOrigin).replace(/\/+$/, '');
const siteUrl = `${origin}/`;
const currentUrl = url || Astro.url.toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${origin}/#organization`,
  name: siteName,
  legalName: company.legalName,
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${origin}/images/logo-192.webp`,
    width: 192,
    height: 259,
  },
  image: `${origin}/og_1200x630.jpg`,
  description:
    'App gratuito só para mulheres com rolês na cidade e companhia para viajar.',
  taxID: company.taxID,
  foundingDate: company.foundingDate,
  email: contactEmail,
  address: {
    '@type': 'PostalAddress',
    addressLocality: company.addressLocality,
    addressRegion: company.addressRegion,
    addressCountry: company.addressCountry,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: contactEmail,
    url: `${origin}/ajuda`,
    availableLanguage: ['pt-BR'],
  },
  sameAs: [instagramUrl, playStoreUrl, appStoreUrl],
  founder: company.founders.map((founder) => ({
    '@type': 'Person',
    ...founder,
  })),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  url: siteUrl,
  name: siteName,
  description:
    'App gratuito só para mulheres com rolês na cidade e companhia para viajar.',
  publisher: {
    '@id': `${origin}/#organization`,
  },
  inLanguage: 'pt-BR',
};

const mobileAppSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: siteName,
    operatingSystem: 'ANDROID',
    applicationCategory: 'TravelApplication',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'BRL',
    },
    description:
      'App gratuito só para mulheres: rolês com data e lugar na sua cidade e companhia para viajar, com selfie verificada pela equipe.',
    image: `${origin}/logo.png`,
    screenshot: `${origin}/og_1200x630.jpg`,
    url: playStoreUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: siteName,
    operatingSystem: 'IOS',
    applicationCategory: 'TravelApplication',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'BRL',
    },
    description:
      'App gratuito só para mulheres: rolês com data e lugar na sua cidade e companhia para viajar, com selfie verificada pela equipe.',
    image: `${origin}/logo.png`,
    screenshot: `${origin}/og_1200x630.jpg`,
    url: appStoreUrl,
  },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': type === 'about' ? 'AboutPage' : 'WebPage',
  '@id': currentUrl,
  url: currentUrl,
  name: title || 'Viajadoras | Rolês e viagens com outras mulheres',
  description:
    description ||
    'App gratuito só para mulheres com rolês na cidade e companhia para viajar.',
  isPartOf: {
    '@id': `${origin}/#website`,
  },
  about: {
    '@id': `${origin}/#organization`,
  },
  inLanguage: 'pt-BR',
};

const schemas =
  type === 'homepage'
    ? [organizationSchema, websiteSchema, ...mobileAppSchemas, webPageSchema]
    : type === 'about'
      ? [organizationSchema, webPageSchema]
      : [webPageSchema];
---

{schemas.map(schema => (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
))}

---
const steps = [
  {
    label: 'Escolha',
    title: 'Ache um rolê com data e lugar',
    description:
      'Trilha, show, café, bate-volta. Rolês criados por mulheres da sua cidade. Não achou o seu? Crie e chame quem topa.',
    accent: 'border-primary/15 bg-primary-50/60',
  },
  {
    label: 'Converse',
    title: 'Chegue conhecendo quem vai',
    description:
      'Entre no grupo do rolê, tire dúvidas e combine os detalhes antes. Nada de chegar no escuro.',
    accent: 'border-teal-500/20 bg-teal-50/80',
  },
  {
    label: 'Viaje',
    title: 'Leve a turma para mais longe',
    description:
      'Quando bater vontade de viajar, encontre mulheres indo para o mesmo destino ou monte seu plano e veja quem embarca.',
    accent: 'border-lavender-500/20 bg-lavender-50/70',
  },
];
---

<section id="como-funciona" class="bg-neutral-50 py-16 lg:py-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">
          Como funciona
        </p>
        <h2 class="mt-4 font-display text-4xl font-semibold leading-tight text-neutral-900 sm:text-[3.2rem]">
          Do "quem topa?"
          <span class="text-primary-700"> ao "vamos!"</span>
        </h2>
      </div>

      <ol class="mt-12 grid gap-4 lg:grid-cols-3">
        {steps.map((step, index) => (
          <li class={`rounded-[2rem] border p-7 ${step.accent}`}>
            <div class="flex items-center justify-between gap-4">
              <span class="text-xs font-semibold uppercase tracking-[0.22em] text-neutral-600">
                {step.label}
              </span>
              <span class="font-display text-3xl text-neutral-400" aria-hidden="true">0{index + 1}</span>
            </div>
            <h3 class="mt-5 text-2xl font-semibold leading-tight text-neutral-900">
              {step.title}
            </h3>
            <p class="mt-4 text-base leading-relaxed text-neutral-700">
              {step.description}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

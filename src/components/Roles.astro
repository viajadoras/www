---
import { Image } from 'astro:assets';
import brunch from '../assets/images/brunch-mesa.webp';
import { instagramUrl } from '../data/site';
---
<section id="roles" aria-labelledby="titulo-encontro" class="bg-secondary-100 py-7 sm:py-10">
  <div class="container">
    <div class="overflow-hidden rounded-3xl bg-teal-900 text-white sm:grid sm:grid-cols-[.9fr_1.1fr]">
      <div class="relative min-h-44 sm:min-h-72">
        <Image src={brunch} alt="Café, mamão e pão de queijo à mesa." widths={[420,720,1000]} sizes="(min-width:640px) 45vw,100vw" class="absolute inset-0 h-full w-full object-cover" />
        <time datetime="2026-12-05T10:00:00-03:00" aria-label="5 de dezembro de 2026" class="absolute left-4 top-4 grid w-16 -rotate-3 overflow-hidden rounded-lg bg-white text-center text-teal-900 shadow-md">
          <span class="bg-primary-700 py-1 text-xs font-bold tracking-widest text-white">DEZ</span>
          <span class="py-1 font-display text-4xl">05</span>
        </time>
      </div>
      <div class="p-6 sm:p-8 lg:p-10">
        <p class="text-sm font-semibold text-teal-100">Encontro do Viajadoras · Goiânia</p>
        <h2 id="titulo-encontro" class="mt-2 font-display text-4xl leading-none lg:text-5xl">Brunch das viajadoras</h2>
        <p class="mt-3">Uma manhã para trocar histórias e dicas sobre viajar sozinha.</p>
        <p class="mt-4 font-semibold"><time datetime="2026-12-05">5 de dezembro</time> · 10h às 14h · Setor Oeste</p>
        <div id="situacao-encontro" class="mt-4">
          <a id="inscricao-brunch" href={instagramUrl} data-action="inscricao_instagram" class="inline-flex rounded-full bg-white px-5 py-3 font-bold text-teal-900">Inscreva-se pela bio do Instagram ↗</a>
          <p class="mt-2 text-sm text-teal-100">Até 29/11. Endereço por WhatsApp para as inscritas.</p>
        </div>
      </div>
    </div>
    <a href="/parcerias/" data-action="parcerias" class="mt-2 inline-block py-2 text-sm font-semibold text-teal-800 underline underline-offset-4">Propor outro rolê em Goiânia</a>
  </div>
</section>
<script>
  const status = document.getElementById('situacao-encontro');
  const now = Date.now();
  if (status && now >= Date.parse('2026-11-30T00:00:00-03:00')) {
    status.textContent = now >= Date.parse('2026-12-05T14:00:00-03:00')
      ? 'A data deste encontro já passou. Veja no app os rolês que as viajadoras estão combinando.'
      : 'O prazo de inscrição para este encontro terminou em 29 de novembro.';
  }
</script>

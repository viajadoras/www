  <div class="container flex flex-wrap items-center justify-between gap-5 py-9">
    <div><h2 class="font-display text-3xl">Baixe o Viajadoras</h2>
    <p class="mt-2 text-teal-100">Um app gratuito para mulheres de espírito viajante.</p></div>
    <AppStoreBadges class="flex flex-wrap items-center gap-3" imgClass="h-auto w-32 sm:w-36" />
  </div>
</section>

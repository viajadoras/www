---
import { Image } from 'astro:assets';
import street from '../assets/images/gallery/gallery-5.png';
import { instagramUrl } from '../data/site';
import AppStoreBadges from './AppStoreBadges.astro';

const fields = [
  { label: 'Passageira', value: 'Você' },
  { label: 'Saindo de', value: 'Sua cidade' },
  { label: 'Destino', value: 'Onde você quiser' },
  { label: 'Companhia', value: 'Mulheres que já foram' },
];
---

<section id="baixar" class="bg-teal-800 py-16 text-white lg:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="ticket mx-auto grid max-w-5xl overflow-hidden rounded-[1.75rem] bg-secondary-50 text-neutral-900 shadow-2xl shadow-black/30 lg:grid-cols-[15rem_1fr_17rem]">
      <Image
        src={street}
        alt="Três amigas caminhando juntas por uma rua de casarões coloridos"
        widths={[480, 720]}
        sizes="(min-width: 1024px) 240px, 100vw"
        class="h-52 w-full object-cover object-[50%_35%] lg:h-full"
      />

      <div class="p-7 sm:p-10">
        <p class="text-sm font-semibold text-teal-700">Cartão de embarque</p>
        <h2 class="mt-3 font-display text-4xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-5xl">
          Sua próxima viagem começa no app.
        </h2>
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-dashed border-secondary-700/50 pt-6">
          {fields.map((field) => (
            <div>
              <dt class="text-xs font-semibold text-neutral-500">{field.label}</dt>
              <dd class="mt-1 font-display text-lg font-semibold leading-snug sm:text-xl">{field.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="stub relative flex flex-col justify-center gap-5 border-t-2 border-dashed border-secondary-700/40 bg-primary-700 p-7 text-white sm:p-10 lg:border-t-0 lg:border-l-2 lg:p-8">
        <div>
          <p class="font-display text-3xl font-semibold leading-none">Embarque grátis</p>
          <p class="mt-3 text-sm leading-relaxed text-white/85">
            Baixe, faça sua selfie de entrada e pergunte para quem já foi.
          </p>
        </div>
        <AppStoreBadges
          class="flex flex-row flex-wrap items-center gap-3 lg:flex-col lg:items-start"
          imgClass="h-auto w-36"
        />
      </div>
    </div>

    <p class="mt-8 text-center">
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-white/85 underline decoration-white/30 underline-offset-4 hover:text-white"
      >
        Siga a gente no Instagram: @viajadorasbr
      </a>
    </p>
  </div>
</section>

<style>
  .ticket {
    position: relative;
  }

  .stub::before,
  .stub::after {
    content: '';
    position: absolute;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: var(--color-teal-800);
  }

  .stub::before {
    top: -1rem;
    left: -1rem;
  }

  .stub::after {
    top: -1rem;
    right: -1rem;
  }

  @media (min-width: 1024px) {
    .stub::before {
      top: -1rem;
      left: -1rem;
    }

    .stub::after {
      top: auto;
      bottom: -1rem;
      right: auto;
      left: -1rem;
    }
  }
</style>

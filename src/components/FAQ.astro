---
import { contactEmail } from '../data/site';
import { siteFaqs } from '../data/faqs';
---

<section id="faq" class="bg-white py-16 lg:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h2 class="font-display text-4xl font-semibold leading-tight text-neutral-900 sm:text-[3.2rem]">
          Antes de ir, a gente responde.
        </h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-neutral-700">
          Ficou outra dúvida? Veja a <a href="/ajuda/" class="font-semibold text-primary-700 underline underline-offset-4">central de ajuda</a> ou escreva para{" "}
          <a href={`mailto:${contactEmail}`} class="font-semibold text-primary-700 underline underline-offset-4">{contactEmail}</a>.
        </p>
      </div>

      <div class="border-t border-neutral-200">
        {siteFaqs.map((faq) => (
          <details class="faq-item group border-b border-neutral-200">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-left">
              <span class="font-display text-xl font-semibold leading-snug text-neutral-900 sm:text-2xl">
                {faq.question}
              </span>
              <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-50 text-primary-700 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
              </span>
            </summary>
            <div class="faq-content">
              <div>
                <p class="max-w-2xl pb-6 text-lg leading-relaxed text-neutral-700">{faq.answer}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid var(--color-primary-700);
    outline-offset: 4px;
  }

  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms ease;
  }

  .faq-item[open] .faq-content {
    grid-template-rows: 1fr;
  }

  .faq-content > div {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-content,
    summary span {
      transition: none;
    }
  }
</style>

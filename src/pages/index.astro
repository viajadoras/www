---
import { Image } from 'astro:assets';
import viagem from '../assets/images/rio-janeiro.webp';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';
import Hero from '../components/hero-section.astro';
import HowItWorks from '../components/how-it-works.astro';
import Roles from '../components/Roles.astro';
import Trust from '../components/Trust.astro';
import Base from '../layouts/Base.astro';

const title = 'Viajadoras | Companhia para viajar e rolês só com mulheres';
const description =
  'App gratuito só para mulheres: ache companhia para viajar e rolês com data e lugar em Goiânia. Converse antes. Selfie verificada pela equipe.';
---

<Base {title} {description} lang="pt-BR">
  <Hero />

  <Roles />
  <HowItWorks />
  <Trust />
  <section class="container grid items-center gap-5 py-9 sm:grid-cols-[12rem_1fr] lg:py-12" aria-labelledby="guia-rio">
    <Image src={viagem} alt="" widths={[240,480]} sizes="(min-width:640px) 192px, 100vw" class="h-32 w-full rounded-2xl object-cover" />
    <div>
      <p class="text-sm font-semibold text-primary-700">Guia de viagem</p>
      <h2 id="guia-rio" class="mt-1 font-display text-2xl text-primary-900"><a href="/blog/rio-de-janeiro-sozinha-mulher/" class="hover:underline">Vai ao Rio sozinha? Veja como planejar os passeios.</a></h2>
      <a href="/blog/" class="mt-2 inline-block py-1 text-primary-800 underline underline-offset-4">Todos os guias de viagem e rolês</a>
    </div>
  </section>
  <FAQ />

  <CTASection />
</Base>

---
import ArticleCards from '../components/ArticleCards.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';
import Hero from '../components/hero-section.astro';
import HowItWorks from '../components/how-it-works.astro';
import UseCases from '../components/use-cases.astro';
import Base from '../layouts/Base.astro';

const title = 'Viajadoras | Companhia feminina para sair e viajar';
const description =
  'Comunidade entre mulheres com grupos, conversa e mais contexto para sair mais na sua cidade e levar essa rede para viagens.';
---

<Base {title} {description} lang="pt-BR">
  <Hero />

  <HowItWorks />

  <UseCases />

  <section class="container py-12 sm:py-20" aria-labelledby="artigos-title">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary-700">Para começar</p>
    <h2 id="artigos-title" class="mt-4 font-display text-3xl font-semibold sm:text-4xl">Uma ideia para o seu próximo encontro</h2>
    <p class="mt-4 max-w-2xl text-lg text-neutral-600">Roteiros para fazer novas amigas, combinar uma viagem e organizar o primeiro passeio de um grupo.</p>
    <ArticleCards heading="h3" />
    <a href="/blog/" class="mt-8 inline-block rounded-full border border-primary-700 px-6 py-3 font-semibold text-primary-700 hover:bg-primary-50">Ver o blog</a>
  </section>

  <FAQ />

  <CTASection />
</Base>

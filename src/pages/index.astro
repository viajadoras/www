---
import ArticleCards from '../components/ArticleCards.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';
import Hero from '../components/hero-section.astro';
import HowItWorks from '../components/how-it-works.astro';
import Roles from '../components/Roles.astro';
import Trust from '../components/Trust.astro';
import UseCases from '../components/use-cases.astro';
import Base from '../layouts/Base.astro';

const title = 'Viajadoras | Viaje sozinha sem ficar sozinha';
const description =
  'App gratuito só para mulheres: dica de quem já foi, companhia no destino e rolês com data e lugar na sua cidade. Selfie verificada pela equipe.';
---

<Base {title} {description} lang="pt-BR">
  <Hero />

  <UseCases />

  <HowItWorks />

  <Roles />

  <Trust />

  <section class="container py-12 sm:py-20" aria-labelledby="artigos-title">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary-700">Para começar</p>
    <h2 id="artigos-title" class="mt-4 font-display text-3xl font-semibold sm:text-4xl">Uma ideia para a sua próxima viagem ou rolê</h2>
    <p class="mt-4 max-w-2xl text-lg text-neutral-700">Guias para viajar sozinha ou com amigas, dividir os gastos e organizar o primeiro rolê do grupo.</p>
    <ArticleCards heading="h3" limit={3} />
    <a href="/blog/" class="mt-8 inline-block rounded-full border border-primary-700 px-6 py-3 font-semibold text-primary-700 hover:bg-primary-50">Ver o blog</a>
  </section>

  <FAQ />

  <CTASection />
</Base>

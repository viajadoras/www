---
import { Font } from 'astro:assets';
import FAQSchema from '../components/FAQSchema.astro';
import StructuredData from '../components/StructuredData.astro';
import { company, contactEmail, funding, instagramUrl } from '../data/site';

interface BaseProps {
  title?: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
  noTracking?: boolean;
  structuredDataType?: 'homepage' | 'about' | 'page';
  ogImage?: string;
  ogType?: 'website' | 'article';
  ogImageAlt?: string;
  downloadHref?: string;
}

const props = Astro.props as BaseProps;
const pageTitle =
  props.title ?? 'Viajadoras | Companhia para viajar e rolês só com mulheres';
const pageDescription =
  props.description ??
  'App gratuito só para mulheres: encontre rolês com data e lugar na sua cidade, converse antes e ache companhia para viajar. Selfie verificada pela equipe.';
const lang = props.lang ?? 'pt-BR';
const noindex = props.noindex ?? false;
const noTracking = props.noTracking ?? false;
const isHomepage = Astro.url.pathname === '/';
const structuredDataType =
  props.structuredDataType ?? (isHomepage ? 'homepage' : 'page');
const canonicalBase = Astro.site ?? Astro.url;
const canonicalPath = Astro.url.pathname.replace(/\/?$/, '/');
const canonicalUrl = new URL(canonicalPath, canonicalBase).toString();
const documentLinks = [
  ['Central de ajuda', '/ajuda/'],
  ['Privacidade', '/privacidade/'],
  ['Termos de uso', '/termos/'],
];
const primaryLinks = [['Início', '/'], ['Blog', '/blog/'], ['Rolês', '/#roles']];
const infoLinks = [['Sobre', '/sobre/'], ['Parcerias', '/parcerias/'], ...documentLinks];
const current = (href: string) => canonicalPath === href ? 'page' :
  href === '/blog/' && canonicalPath.startsWith('/blog/') ? 'location' : undefined;
const isDocument = documentLinks.some(([, href]) => href === canonicalPath);
const robotsContent = noindex
  ? 'noindex, nofollow, noarchive'
  : 'index, follow, max-image-preview:large';

const downloadHref =
  props.downloadHref ??
  (isHomepage
    ? '/#baixar'
    : `/?origem=${encodeURIComponent(Astro.url.pathname)}#baixar`);
const OG_VERSION = '20251002';
const ogPath = props.ogImage ?? `/og_1200x630.jpg?v=${OG_VERSION}`;
const ogImage = new URL(ogPath, canonicalBase).toString();
const ogImageType = /\.png(\?|$)/.test(ogPath) ? 'image/png' : 'image/jpeg';
const ogAlt = props.ogImageAlt ?? 'Amigas juntas em um rolê, Viajadoras';

import '../styles/global.css';
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {isHomepage && <meta name="msvalidate.01" content="559EEB0BFC81A0A64DFA43686A4D3816" />}

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Viajadoras" />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#C96949" />
    <meta name="color-scheme" content="light" />

    <!-- Preconnect to external domains for better performance -->
    {!noTracking && (
      <Fragment>
        <link rel="preconnect" href="https://us-assets.i.posthog.com" crossorigin />
      </Fragment>
    )}

    <Font cssVariable="--face-fraunces" preload />
    <Font cssVariable="--face-manrope" preload />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Blog Viajadoras" href="/rss.xml" />
    {!noindex && <link rel="alternate" hreflang={lang} href={canonicalUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={props.ogType ?? 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Viajadoras" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="twitter:site" content="@viajadorasbr" />

    {!noTracking && (
      <Fragment>
    <!-- PostHog em modo cookieless: sem cookies nem armazenamento local; visitantes únicos por hash no servidor -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey canRenderSurveyAsync identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      if (['viajadoras.com', 'www.viajadoras.com'].includes(location.hostname)) {
        posthog.init('phc_ySR9dHZgiEv7nQ9QHLyqGnmYpjSu9kezRWBu8b5QGhXs', {
          api_host: 'https://us.i.posthog.com',
          defaults: '2026-05-30',
          person_profiles: 'identified_only',
          cookieless_mode: 'always',
          capture_exceptions: true,
        });
      }
    </script>
      </Fragment>
    )}

    <!-- Structured Data (Schema.org) -->
    <StructuredData
      type={structuredDataType}
      title={pageTitle}
      description={pageDescription}
      url={canonicalUrl}
      path={canonicalPath}
    />
    {isHomepage && <FAQSchema />}
    <slot name="head" />
  </head>
  <body data-site-metrics={noTracking ? undefined : "enabled"} class="bg-neutral-50 text-neutral-900 font-sans antialiased">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-neutral-900 focus:shadow-lg">Pular para o conteúdo</a>
    <header class="sticky top-0 z-50 border-b border-secondary-200 bg-secondary-50">
      <div class="container mx-auto flex min-h-14 items-center justify-between gap-2 px-4 sm:min-h-16 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-1.5 sm:gap-2" aria-label="Viajadoras, página inicial">
          <img src="/images/logo-fundo-claro.webp" alt="" width="105" height="144" class="h-9 w-auto sm:h-10" />
          <span class="font-display text-lg font-semibold tracking-tight text-primary-900 sm:text-2xl">Viajadoras</span>
        </a>
        <nav aria-label="Principal" class="flex items-center gap-1 text-sm font-semibold sm:gap-5">
          {primaryLinks.map(([label, href]) => <a href={href} aria-current={current(href)} class="hidden py-3 underline-offset-4 hover:underline aria-[current]:underline md:inline-flex">{label}</a>)}
          <details id="site-menu" class="relative">
            <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-lg px-2 hover:bg-secondary-100 [&::-webkit-details-marker]:hidden">Menu <span aria-hidden="true">⌄</span></summary>
            <div class="site-menu-panel absolute right-0 top-full z-50 mt-1 w-56 overflow-y-auto rounded-xl border border-secondary-200 bg-white p-2 shadow-lg">
              {[...primaryLinks, ['Como funciona', '/#como-funciona'], ...infoLinks].map(([label,href]) =>
                <a href={href} aria-current={current(href)} class:list={['block rounded-md px-3 py-2 hover:bg-secondary-100 focus-visible:bg-secondary-100 aria-[current]:bg-secondary-100', primaryLinks.some(([,url])=>url===href) && 'md:hidden']}>{label}</a>
              )}
            </div>
          </details>
          <a href={downloadHref} data-cta="cabecalho" data-download class="inline-flex min-h-11 items-center whitespace-nowrap rounded-full bg-primary-700 px-3 text-white hover:bg-primary-800 sm:px-5">Baixar o app</a>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      {(isDocument || canonicalPath === '/blog/') &&
        <div class="container flex flex-wrap items-center justify-between gap-x-5 gap-y-2 pt-4 text-sm">
          <nav aria-label="Localização" class="flex items-center gap-2 text-neutral-700">
            <a href="/" class="text-primary-800 underline underline-offset-4">Início</a><span aria-hidden="true">/</span>
            <span aria-current="page">{documentLinks.find(([,href]) => href === canonicalPath)?.[0] ?? 'Blog'}</span>
          </nav>
          {isDocument && <nav aria-label="Ajuda e documentos" class="flex flex-wrap gap-x-4">
            {documentLinks.filter(([,href]) => href !== canonicalPath).map(([label,href]) => <a href={href} class="py-1 text-primary-800 underline underline-offset-4">{label}</a>)}
          </nav>}
        </div>}

      <slot />
    </main>
    <footer id="rodape" class="bg-secondary-100 py-6 text-neutral-700">
      <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
          <div>
            <p class="font-display text-2xl font-semibold text-primary-900">Viajadoras</p>
            <a class="text-sm text-primary-800 underline-offset-4 hover:underline" href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </div>
          <nav aria-label="Contato e informações" class="flex flex-wrap gap-x-5 text-sm font-semibold text-primary-800 [&_a]:py-1 [&_a:hover]:underline">
            <a href="/">Início</a>
            <a href="/blog/">Blog</a>
            <a href="/sobre/">Sobre nós</a>
            <a href="/ajuda/">Central de ajuda</a>
            <a href="/parcerias/" data-action="parcerias">Parcerias</a>
            <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
          </nav>
        </div>
        <div class="mt-5 flex flex-col gap-2 border-y border-secondary-300 py-2 text-sm text-neutral-700 md:flex-row md:items-center md:justify-between">
          <p class="max-w-sm">Projeto apoiado pelo programa {funding.program}: {funding.sponsors}.</p>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-3 bg-secondary-100 sm:gap-x-6">
            <a href="/sobre/#apoio" class="rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-700">
              <img src="/images/apoio/centelha-projeto-aprovado.webp" alt="Centelha MCTI — Projeto aprovado na 3ª edição" width="480" height="480" loading="lazy" class="h-auto w-24" />
            </a>
            <img src="/images/apoio/fapeg.png" alt="FAPEG, Fundação de Amparo à Pesquisa do Estado de Goiás" width="331" height="121" loading="lazy" class="h-8 w-auto mix-blend-multiply sm:h-10" />
            <a href={funding.finepUrl} target="_blank" rel="noopener noreferrer" class="rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-700">
              <img src="/images/apoio/finep.png" alt="Finep, Inovação e Pesquisa. Abre o portal da Finep" width="275" height="170" loading="lazy" class="h-11 w-auto sm:h-12" />
            </a>
          </div>
        </div>
        <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 text-xs text-neutral-600">
          <p>© {new Date().getFullYear()} {company.legalName} · CNPJ {company.cnpj} · {company.addressLocality} – {company.addressRegion}</p>
          <nav aria-label="Privacidade e conta" class="flex flex-wrap gap-x-4 text-sm text-primary-800 [&_a]:py-1 [&_a:hover]:underline">
            <a href="/privacidade/">Privacidade</a>
            <a href="/termos/">Termos de uso</a>
            <a href="/ajuda/#excluir-conta">Excluir minha conta</a>
          </nav>
        </div>
      </div>
    </footer>
    <script>
      import { deviceStoreUrl, recordStoreClick, storeClick } from '../scripts/product-links';

      const menu = document.querySelector<HTMLDetailsElement>('#site-menu');
      if (menu) {
        document.addEventListener('click', (event) => {
          if (event.target instanceof Element && (!menu.contains(event.target) || event.target.closest('a'))) menu.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
        menu.addEventListener('focusout', (event) => {
          if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
        });
      }

      declare global {
        interface Window {
          posthog?: {
            capture: (event: string, properties?: Record<string, string>) => void;
          };
        }
      }

      const storeUrl = deviceStoreUrl(navigator.userAgent, navigator.maxTouchPoints);
      if (storeUrl) {
        document.querySelectorAll<HTMLAnchorElement>('a[data-download]').forEach((link) => {
          link.href = storeUrl;
        });
      }

      const production = ['viajadoras.com', 'www.viajadoras.com'].includes(location.hostname);
      const preview = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
      function capture(event: string, properties: Record<string, string>) {
        if (production) window.posthog?.capture(event, properties);
        else if (preview) console.info('[Medição local]', event, properties);
      }

      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || !(event.target instanceof Element)) return;
        if (!document.body.hasAttribute('data-site-metrics') || (!production && !preview)) return;
        const link = event.target.closest<HTMLAnchorElement>('a[href]');
        if (!link) return;
        const action = link.dataset.action;
        const section = link.closest('section[id]')?.id;
        if (action) {
          capture('site_action', {
            acao: action,
            pagina: location.pathname,
            local: link.closest('footer') ? 'rodape' : section || 'conteudo',
          });
        }
        const click = storeClick(link.href, window.location.pathname, window.location.search);
        if (!click) return;
        if (production) {
          void recordStoreClick(click).then((falha) => {
            if (falha) capture('store_click_error', { motivo: falha, loja: click.platform });
          });
        }
        // Onde estava o botão: dobra inicial, meio ou fim da página (sem marcar cada CTA à mão).
        const top = link.getBoundingClientRect().top + window.scrollY;
        const posicao = link.closest('header')
          ? 'cabecalho'
          : link.closest('footer')
            ? 'rodape'
            : top < window.innerHeight
              ? 'topo'
              : top < document.documentElement.scrollHeight * 0.66
                ? 'meio'
                : 'fim';
        // PostHog, sem cookies nem dados pessoais.
        capture('store_click', {
          store: click.platform === 'ios' ? 'app' : 'play',
          origem: click.source,
          posicao,
          cta: link.closest<HTMLElement>('[data-cta]')?.dataset.cta ?? 'outro',
        });
      });

      // Global Scroll Reveal Observer (unified — handles .scroll-reveal + optional data-delay)
      function initScrollReveal() {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const delay = parseInt(entry.target.getAttribute('data-delay') || '0', 10);
              if (delay > 0) {
                setTimeout(() => entry.target.classList.add('revealed'), delay);
              } else {
                entry.target.classList.add('revealed');
              }
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }

      // Re-initialize on Astro page transitions
      document.addEventListener('astro:page-load', initScrollReveal);
    </script>
  </body>

</html>

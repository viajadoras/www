---
import FAQSchema from '../components/FAQSchema.astro';
import IconInstagram from '../components/IconInstagram.astro';
import StructuredData from '../components/StructuredData.astro';
import { company, contactEmail, funding, instagramUrl } from '../data/site';

interface BaseProps {
  title?: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
  noTracking?: boolean;
  structuredDataType?: 'homepage' | 'about' | 'page';
  ogImage?: string;
  ogType?: 'website' | 'article';
  ogImageAlt?: string;
  downloadHref?: string;
}

const props = Astro.props as BaseProps;
const pageTitle = props.title ?? 'Viajadoras | Viaje sozinha sem ficar sozinha';
const pageDescription =
  props.description ??
  'App gratuito só para mulheres: encontre rolês com data e lugar na sua cidade, converse antes e ache companhia para viajar. Selfie verificada pela equipe.';
const lang = props.lang ?? 'pt-BR';
const noindex = props.noindex ?? false;
const noTracking = props.noTracking ?? false;
const isHomepage = Astro.url.pathname === '/';
const structuredDataType =
  props.structuredDataType ?? (isHomepage ? 'homepage' : 'page');
const canonicalBase = Astro.site ?? Astro.url;
const canonicalUrl = canonicalBase
  ? new URL(Astro.url.pathname, canonicalBase).toString()
  : '';
const robotsContent = noindex
  ? 'noindex, nofollow, noarchive'
  : 'index, follow, max-image-preview:large';

const downloadHref =
  props.downloadHref ??
  (isHomepage
    ? '/#baixar'
    : `/?origem=${encodeURIComponent(Astro.url.pathname)}#baixar`);
const OG_VERSION = '20251002';
const ogPath = props.ogImage ?? `/og_1200x630.jpg?v=${OG_VERSION}`;
const ogImage = new URL(ogPath, canonicalBase).toString();
const ogAlt = props.ogImageAlt ?? 'Amigas juntas em um rolê, Viajadoras';

import '../styles/global.css';
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {isHomepage && <meta name="msvalidate.01" content="559EEB0BFC81A0A64DFA43686A4D3816" />}

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Viajadoras" />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#C96949" />
    <meta name="color-scheme" content="light" />

    <!-- Preconnect to external domains for better performance -->
    {!noTracking && (
      <Fragment>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="preconnect" href="https://plausible.io" />
      </Fragment>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={props.ogType ?? 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Viajadoras" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="twitter:site" content="@viajadorasbr" />
    <meta name="twitter:url" content={canonicalUrl} />

    {!noTracking && (
      <Fragment>
    <!-- Google tag (gtag.js) - Google Ads -->
    <script is:inline defer src="https://www.googletagmanager.com/gtag/js?id=AW-17592059630"></script>
    <script is:inline defer>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-17592059630');
    </script>

    <!-- Plausible Analytics -->
    <script is:inline async src="https://plausible.io/js/pa-AneWwDMiqdsQZ1ShDurPK.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init();
    </script>
      </Fragment>
    )}

    <!-- Structured Data (Schema.org) -->
    <StructuredData
      type={structuredDataType}
      title={pageTitle}
      description={pageDescription}
      url={canonicalUrl}
    />
    {isHomepage && <FAQSchema />}
    <slot name="head" />
  </head>
  <body class="bg-neutral-50 text-neutral-900 font-sans antialiased">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-neutral-900 focus:shadow-lg">Pular para o conteúdo</a>
    <header class="sticky top-0 z-50 w-full border-b border-primary/10 bg-[#F4EBE3]/95 backdrop-blur-sm">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between sm:h-18">
          <a href="/" class="flex items-center gap-2 sm:gap-3" aria-label="Viajadoras, página inicial">
            <div class="relative flex h-11 w-11 items-center justify-center sm:h-12 sm:w-12">
              <div class="absolute inset-0 rounded-full bg-[#DEC0AA] shadow-[0_8px_18px_rgba(23,23,23,0.08)]"></div>
              <img src="/images/logo-96.webp" alt="" width="96" height="130" class="relative z-10 h-10 w-10 object-contain filter-[drop-shadow(0_1px_1px_rgba(23,23,23,0.16))_drop-shadow(0_4px_12px_rgba(23,23,23,0.10))] sm:h-11 sm:w-11" />
            </div>
            <div class="flex flex-col">
              <span class="font-display text-base font-semibold text-neutral-900 tracking-tight sm:text-[1.75rem]">Viajadoras</span>
            </div>
          </a>
          <nav class="hidden lg:flex items-center gap-1" aria-label="Principal">
            <a class="relative px-4 py-2 text-sm font-medium text-neutral-700 hover:text-neutral-900 transition-colors group" href="/#como-funciona">
              Como funciona
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-linear-to-r from-primary to-secondary group-hover:w-full transition-all duration-300"></span>
            </a>
            <a class="relative px-4 py-2 text-sm font-medium text-neutral-700 hover:text-neutral-900 transition-colors group" href="/#roles">
              Rolês
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-linear-to-r from-primary to-secondary group-hover:w-full transition-all duration-300"></span>
            </a>
            <a class="relative px-4 py-2 text-sm font-medium text-neutral-700 hover:text-neutral-900 transition-colors group" href="/#confianca">
              Confiança
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-linear-to-r from-primary to-secondary group-hover:w-full transition-all duration-300"></span>
            </a>
            <a class="relative px-4 py-2 text-sm font-medium text-neutral-700 hover:text-neutral-900 transition-colors group" href="/sobre/">
              Sobre nós
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-linear-to-r from-primary to-secondary group-hover:w-full transition-all duration-300"></span>
            </a>
          </nav>
          <div class="flex items-center gap-1 sm:gap-4">
            <a href="/ajuda/" class="rounded-md px-2 py-2 text-sm font-semibold text-neutral-800 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-700">Ajuda</a>
            <a href="/blog/" class="rounded-md px-2 py-2 text-sm font-semibold text-neutral-800 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-700">Blog</a>
            <a
              href={downloadHref}
              class="hidden rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary-600 lg:inline-flex"
            >
              <span>Baixar o app</span>
            </a>
            <a
              href={downloadHref}
              class="rounded-full bg-primary px-2 py-2 text-sm font-semibold text-white transition hover:bg-primary-600 lg:hidden"
              aria-label="Baixar o app"
            >
              Baixar
            </a>
          </div>
        </div>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="bg-neutral-900 py-16 text-neutral-100">
      <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.3fr_1fr_1fr_0.8fr]">
          <div>
            <p class="text-lg font-bold text-white">Viajadoras</p>
            <p class="mt-2 text-sm leading-6 text-neutral-400">Viagens e rolês só de mulheres. Dica de quem já foi, companhia no destino e selfie verificada pela equipe.</p>
            <p class="mt-4 text-sm leading-6 text-neutral-400">App gratuito para Android e iPhone, feito em {company.addressLocality} – {company.addressRegion}.</p>
            <a class="mt-2 inline-block text-sm text-neutral-300 underline-offset-4 hover:text-primary hover:underline" href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </div>
          <div>
            <h2 class="font-semibold uppercase tracking-wider text-white text-sm">Site</h2>
            <nav class="mt-4 flex flex-col gap-2">
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/#como-funciona">Como funciona</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/#confianca">Confiança</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/#faq">FAQ</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/sobre/">Sobre nós</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/blog/">Blog</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/ajuda/">Central de ajuda</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href={downloadHref}>Baixar o app</a>
            </nav>
          </div>
          <div>
            <h2 class="font-semibold uppercase tracking-wider text-white text-sm">Guias</h2>
            <nav class="mt-4 flex flex-col gap-2">
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/viajar-sozinha-mulher/">Viajar sozinha</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/viagens-para-mulheres/">Viagens para mulheres</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/companhia-para-viajar/">Companhia para viajar</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/companhia-feminina-para-sair/">Companhia feminina para sair</a>
            </nav>
          </div>
          <div>
            <h2 class="font-semibold uppercase tracking-wider text-white text-sm">Legal e redes</h2>
            <nav class="mt-4 flex flex-col gap-2">
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/termos/">Termos de Uso</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/privacidade/">Privacidade</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href="/ajuda/#excluir-conta">Excluir minha conta</a>
              <a class="text-neutral-400 hover:text-primary transition-colors text-sm" href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
            </nav>
            <div class="mt-4">
              <a class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-neutral-800 text-neutral-400 transition-all hover:bg-primary hover:text-white" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <IconInstagram class="h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
        <div class="mt-12 flex flex-col gap-5 rounded-2xl bg-white px-6 py-5 text-sm text-neutral-700 md:flex-row md:items-center md:justify-between">
          <p class="max-w-sm">Projeto apoiado pelo programa {funding.program}: {funding.sponsors}.</p>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <img src="/images/apoio/centelha-go.png" alt="Centelha Goiás" width="310" height="88" loading="lazy" class="h-8 w-auto" />
            <img src="/images/apoio/fapeg.png" alt="FAPEG, Fundação de Amparo à Pesquisa do Estado de Goiás" width="331" height="121" loading="lazy" class="h-10 w-auto" />
            <a href={funding.finepUrl} target="_blank" rel="noopener noreferrer" class="rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-700">
              <img src="/images/apoio/finep.png" alt="Finep, Inovação e Pesquisa. Abre o portal da Finep" width="275" height="170" loading="lazy" class="h-12 w-auto" />
            </a>
          </div>
        </div>
        <div class="mt-8 border-t border-neutral-800 pt-8 text-center text-sm text-neutral-400">
          <p>© {new Date().getFullYear()} Viajadoras. Todos os direitos reservados.</p>
          <p class="mt-2">{company.legalName} · CNPJ {company.cnpj} · {company.addressLocality} – {company.addressRegion}</p>
        </div>
      </div>
    </footer>
    <script>
      import { recordStoreClick, storeClick } from '../scripts/product-links';

      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || !(event.target instanceof Element)) return;
        if (!['viajadoras.com', 'www.viajadoras.com'].includes(window.location.hostname)) return;
        if (window.location.pathname.startsWith('/acompanhar')) return;
        const link = event.target.closest<HTMLAnchorElement>('a[href]');
        if (!link) return;
        const click = storeClick(link.href, window.location.pathname, window.location.search);
        if (click) void recordStoreClick(click);
      });

      // Global Scroll Reveal Observer (unified — handles .scroll-reveal + optional data-delay)
      function initScrollReveal() {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const delay = parseInt(entry.target.getAttribute('data-delay') || '0', 10);
              if (delay > 0) {
                setTimeout(() => entry.target.classList.add('revealed'), delay);
              } else {
                entry.target.classList.add('revealed');
              }
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }

      // Re-initialize on Astro page transitions
      document.addEventListener('astro:page-load', initScrollReveal);
    </script>
  </body>

</html>
